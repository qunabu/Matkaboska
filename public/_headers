# Never cache the service worker, HTML shell, or manifest so the PWA can always
# detect and apply a new version. Hashed JS/CSS assets keep default caching.
/sw.js
  Cache-Control: no-store, must-revalidate
/push-sw.js
  Cache-Control: no-store, must-revalidate
/workbox-*.js
  Cache-Control: no-store, must-revalidate
/index.html
  Cache-Control: no-store, must-revalidate
/
  Cache-Control: no-store, must-revalidate
/manifest.webmanifest
  Cache-Control: no-cache

# Security headers for every static response (the HTML shell is served straight
# from assets, without the Worker). The same set is added to /api/* in the Worker.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), geolocation=(), payment=(), microphone=(self)
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
