# Kopiuj do .env i uzupełnij. Plik .env jest w .gitignore (nie commituj sekretów).

# API aplikacji Matka Boska
MBL_BASE_URL=https://meal-planner.qunabu.workers.dev
MBL_PIN=twoj-pin

# --- Frisco: uwierzytelnienie (wybierz JEDNO) --------------------------------

# ZALECANE: refresh token OAuth (bez hasła, wielokrotnego użytku).
# Zdobądź go RAZ — sam odpal w terminalu request do connect/token
# (grant_type=password) i skopiuj pole "refresh_token" z odpowiedzi JSON.
# Skrypt sam wymienia go na świeży access_token przy każdym uruchomieniu.
FRISCO_REFRESH_TOKEN=

# ALBO fallback: pełny nagłówek Cookie z przeglądarki (access token żyje ~10 min).
# DevTools → Network → dowolne żądanie /app/commerce → Request Headers → Cookie.
# FRISCO_COOKIE=sessionIdN=...; userIdN=1316086; sid=...; warehouse=GDA

# Opcjonalne
FRISCO_WAREHOUSE=GDA
# FRISCO_SID=
